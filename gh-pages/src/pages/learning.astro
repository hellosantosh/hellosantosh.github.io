---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = (await getCollection('learning')).sort((a, b) => a.data.order - b.data.order);
const total = sections.reduce((n, s) => n + s.data.groups.reduce((m, g) => m + g.items.length, 0), 0);
---

<BaseLayout title="Learning journey" description="Professional courses, certifications, licenses, and conferences.">
	<div class="container">
		<header class="page-header">
			<p class="eyebrow">Learning journey</p>
			<h1>Always a student</h1>
			<p class="lede">
				{total} courses, certifications, licenses, and conferences so far, and counting.
			</p>
			<nav class="jump" aria-label="Sections">
				{sections.map((s) => <a class="chip" href={`#${s.id}`}>{s.data.title}</a>)}
			</nav>
		</header>

		{
			sections.map((section) => (
				<section class="section" id={section.id}>
					<div class="section-head">
						<h2>{section.data.title}</h2>
					</div>
					<div class="groups">
						{section.data.groups.map((group) => (
							<div class="card group">
								<h3>{group.name}</h3>
								<ul>
									{group.items.map((item) => (
										<li>
											{item.url ? (
												<a href={item.url} rel="noopener">
													{item.title}
												</a>
											) : (
												<span>{item.title}</span>
											)}
											{(item.by || item.date) && (
												<small>{[item.by, item.date].filter(Boolean).join(' · ')}</small>
											)}
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</section>
			))
		}
	</div>
</BaseLayout>

<style>
	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.75rem;
	}
	.groups {
		columns: 20rem;
		column-gap: 1rem;
	}
	.group {
		break-inside: avoid;
		padding: 1.25rem 1.4rem;
		margin-bottom: 1rem;
	}
	h3 {
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0 0 0.75rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		padding: 0.45rem 0;
		border-top: 1px solid var(--border);
		font-size: 0.96rem;
		line-height: 1.45;
	}
	li:first-child {
		border-top: 0;
		padding-top: 0;
	}
	li a {
		text-decoration: none;
	}
	small {
		display: block;
		color: var(--faint);
		font-size: 0.82rem;
		margin-top: 0.15rem;
	}
</style>
