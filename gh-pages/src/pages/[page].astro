---
// Renders every Markdown file in src/content/pages/ at /<file-name>/.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import '../styles/prose.css';

export async function getStaticPaths() {
	const pages = await getCollection('pages');
	return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}

interface Props {
	page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
	<div class="container narrow">
		<header class="page-header">
			<h1>{page.data.title}</h1>
			<p class="lede">{page.data.description}</p>
		</header>
		<div class="prose"><Content /></div>
		{
			page.id === 'about' && (
				<section class="section" id="contact">
					<div class="section-head">
						<h2>Get in touch</h2>
					</div>
					<ul class="contact">
						{site.socials.map((s) => (
							<li>
								<a class="card" href={s.href} rel="me noopener">
									{s.label} <span aria-hidden="true">↗</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</BaseLayout>

<style>
	.contact {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.contact a {
		padding: 0.75rem 1.25rem;
		font-weight: 500;
	}
	.contact span {
		color: var(--accent);
	}
</style>
