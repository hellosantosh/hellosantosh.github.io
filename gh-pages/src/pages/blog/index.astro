---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---

<BaseLayout title="Writing" description="Everything I've written, newest first.">
	<div class="container">
		<header class="page-header">
			<p class="eyebrow">Writing</p>
			<h1>Notes & essays</h1>
			<p class="lede">
				Thoughts on architecture, engineering, product, AI, and everything else. Subscribe via <a
					href="/rss.xml">RSS</a
				>.
			</p>
		</header>
		{posts.length === 0 && <PostList posts={[]} />}
		{
			years.map((year) => (
				<section class="year">
					<h2>{year}</h2>
					<PostList posts={posts.filter((p) => p.data.date.getUTCFullYear() === year)} />
				</section>
			))
		}
	</div>
</BaseLayout>

<style>
	.year {
		display: grid;
		grid-template-columns: 8rem 1fr;
		gap: 1rem;
		padding-block: 1.5rem;
		border-top: 1px solid var(--border);
	}
	.year h2 {
		font-size: 1.5rem;
		margin: 1rem 0 0;
		color: var(--faint);
	}
	@media (max-width: 760px) {
		.year {
			grid-template-columns: 1fr;
		}
	}
</style>
