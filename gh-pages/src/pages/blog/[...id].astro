---
import { getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, readingTime, type Post } from '../../lib/content';
import '../../styles/prose.css';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { id: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const topics = await getEntries(post.data.topics);
const { title, description, date, updated, cover, coverAlt } = post.data;
---

<BaseLayout title={title} description={description} type="article">
	<article class="container narrow">
		<header class="page-header">
			<a href="/blog/" class="back">← All writing</a>
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			<div class="meta">
				<time datetime={date.toISOString()}>{formatDate(date)}</time>
				<span aria-hidden="true">·</span>
				<span>{readingTime(post.body)}</span>
				{
					updated && (
						<>
							<span aria-hidden="true">·</span>
							<span>Updated {formatDate(updated)}</span>
						</>
					)
				}
			</div>
			{
				topics.length > 0 && (
					<div class="topics">
						{topics.map((t) => (
							<a class="chip" href={`/topics/${t.id}/`}>
								{t.data.title}
							</a>
						))}
					</div>
				)
			}
		</header>
		{cover && <Image src={cover} alt={coverAlt ?? ''} class="cover" widths={[672, 1344]} sizes="(max-width: 720px) 100vw, 672px" />}
		<div class="prose">
			<Content />
		</div>
		{
			(newer || older) && (
				<nav class="pager" aria-label="More posts">
					{older ? (
						<a href={`/blog/${older.id}/`} class="card">
							<span>← Older</span>
							{older.data.title}
						</a>
					) : (
						<span />
					)}
					{newer && (
						<a href={`/blog/${newer.id}/`} class="card next">
							<span>Newer →</span>
							{newer.data.title}
						</a>
					)}
				</nav>
			)
		}
	</article>
</BaseLayout>

<style>
	.back {
		display: inline-block;
		font-size: 0.9rem;
		color: var(--muted);
		text-decoration: none;
		margin-bottom: 2rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
		font-size: 0.9rem;
		color: var(--faint);
	}
	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.cover {
		width: 100%;
		border-radius: var(--radius);
		margin-bottom: 2.5rem;
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
	.pager a {
		padding: 1rem 1.25rem;
		font-family: var(--font-serif);
		font-size: 1.15rem;
		line-height: 1.3;
	}
	.pager span {
		display: block;
		font-family: var(--font-sans);
		font-size: 0.8rem;
		color: var(--faint);
		margin-bottom: 0.3rem;
	}
	.pager .next {
		text-align: right;
	}
	@media (max-width: 560px) {
		.pager {
			grid-template-columns: 1fr;
		}
	}
</style>
