---
import type { Topic } from '../lib/content';

interface Props {
	topics: Topic[];
	counts?: Record<string, number>;
}

const { topics, counts = {} } = Astro.props;
---

<ul class="grid">
	{
		topics.map((topic, i) => (
			<li>
				<a href={`/topics/${topic.id}/`} class="card topic">
					<span class="num">{String(i + 1).padStart(2, '0')}</span>
					<h3>{topic.data.title}</h3>
					<p>{topic.data.description}</p>
					<span class="meta">
						{counts[topic.id] ? `${counts[topic.id]} post${counts[topic.id] === 1 ? '' : 's'}` : 'Explore'}
						<span aria-hidden="true">→</span>
					</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}
	li {
		flex: 1 1 17rem;
	}
	.topic {
		height: 100%;
		display: flex;
		flex-direction: column;
		padding: 1.4rem 1.4rem 1.2rem;
	}
	.num {
		font-family: var(--font-serif);
		font-size: 0.95rem;
		color: var(--accent);
		margin-bottom: 1.5rem;
	}
	h3 {
		font-size: 1.45rem;
		margin: 0 0 0.4rem;
	}
	p {
		margin: 0 0 1.25rem;
		color: var(--muted);
		font-size: 0.95rem;
		flex: 1;
	}
	.meta {
		display: flex;
		justify-content: space-between;
		font-size: 0.85rem;
		color: var(--faint);
	}
	.topic:hover .meta {
		color: var(--accent);
	}
</style>
